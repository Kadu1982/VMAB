<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Mantem logs legiveis no console e persistidos em arquivo para VPS e debug local. -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="backend"/>
    <springProperty scope="context" name="LOG_DIR" source="vmab.log-dir" defaultValue="logs"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level app=${APP_NAME} trace=%X{correlationId:-na} user=%X{username:-anonymous} roles=%X{roles:-na} method=%X{httpMethod:-na} path=%X{httpPath:-na} status=%X{httpStatus:-na} durationMs=%X{durationMs:-na} ip=%X{clientIp:-na} logger=%logger{36} thread=%thread msg=%msg%n%ex{full}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/vmab.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/vmab.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>250MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.seguranca.plataforma" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
